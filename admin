<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<script>
(function() {
  // ============ FIREBASE CONFIG ============
  const firebaseConfig = {
    apiKey: "AIzaSyDFQQ1cHavVG3X0yLm7qGpTOWCQziFLUeQ",
    authDomain: "studymine-fa92d.firebaseapp.com",
    projectId: "studymine-fa92d",
    storageBucket: "studymine-fa92d.firebasestorage.app",
    messagingSenderId: "460797718327",
    appId: "1:460797718327:web:66316f16930b304b2e34b2",
    measurementId: "G-ZBJ6GLM3L8"
  };

  let ADMIN_EMAILS = ["mgbhaukali@gmail.com", "manshi@gmail.com"];

  try { firebase.initializeApp(firebaseConfig); } catch(e) {}
  const auth = firebase.auth();
  const db = firebase.firestore();

  // ============ STATE ============
  let currentUser = null;
  let allUsers = [];
  let allRooms = [];
  let allMessages = [];
  let currentPage = 'dashboard';
  let deleteTarget = null;
  let userGrowthChart = null;
  let messageActivityChart = null;

  // ============ DOM HELPERS ============
  const $ = id => document.getElementById(id);

  // ============ TOAST SYSTEM ============
  function showToast(msg, type = 'info') {
    const container = $('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
    toast.innerHTML = `
      <span class="toast-icon">${icons[type] || icons.info}</span>
      <span>${msg}</span>
      <button class="toast-close" onclick="this.parentElement.remove()">✕</button>
    `;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }

  // ============ SIDEBAR TOGGLE ============
  window.toggleSidebar = function() {
    $('sidebar').classList.toggle('open');
  };

  // ============ NAVIGATION ============
  window.navigateTo = function(page) {
    currentPage = page;
    document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
    const pageEl = document.getElementById('page-' + page);
    if (pageEl) pageEl.style.display = 'block';

    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    const navItem = document.querySelector(`.nav-item[data-page="${page}"]`);
    if (navItem) navItem.classList.add('active');

    const titles = {
      dashboard: '📊 Dashboard Overview',
      users: '👥 User Management',
      rooms: '💬 Chat Rooms',
      messages: '📨 Message Overview',
      activity: '📈 Activity Log',
      admins: '👑 Admin Accounts',
      settings: '⚙️ System Settings'
    };
    $('headerTitle').textContent = titles[page] || 'Dashboard';

    if (page === 'users') renderAllUsers();
    if (page === 'rooms') renderRooms();
    if (page === 'messages') loadMessages();
    if (page === 'activity') loadActivity();
    if (page === 'admins') renderAdmins();
    if (page === 'settings') loadSettings();

    // Close sidebar on mobile
    if (window.innerWidth < 1024) $('sidebar').classList.remove('open');
  };

  // Navigation click handlers
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => navigateTo(item.dataset.page));
  });

  // ============ AUTH ============
  $('loginBtn').addEventListener('click', async () => {
    const email = $('emailInput').value.trim().toLowerCase();
    const pw = $('passwordInput').value.trim();
    $('errorMsg').textContent = '';

    if (!email || !pw) { $('errorMsg').textContent = 'Please fill all fields'; return; }
    if (!ADMIN_EMAILS.includes(email)) { $('errorMsg').textContent = '❌ Access Denied: Not an admin account'; return; }

    $('loginBtn').disabled = true;
    try {
      await auth.signInWithEmailAndPassword(email, pw);
    } catch (e) {
      const errors = { 'auth/user-not-found': 'Account not found', 'auth/wrong-password': 'Incorrect password' };
      $('errorMsg').textContent = errors[e.code] || 'Login failed';
    }
    $('loginBtn').disabled = false;
  });

  $('passwordInput').addEventListener('keypress', e => { if (e.key === 'Enter') $('loginBtn').click(); });

  window.logout = async function() {
    await auth.signOut();
  };

  // ============ AUTH STATE ============
  auth.onAuthStateChanged(async user => {
    if (user) {
      if (!ADMIN_EMAILS.includes(user.email)) {
        await auth.signOut();
        return;
      }
      currentUser = user;
      $('sidebarUserName').textContent = user.email.split('@')[0];
      $('userAvatar').textContent = user.email[0].toUpperCase();
      $('loginScreen').style.display = 'none';
      $('sidebar').style.display = 'flex';
      $('mainContent').style.display = 'block';
      await loadAllData();
      initCharts();
    } else {
      currentUser = null;
      $('loginScreen').style.display = 'flex';
      $('sidebar').style.display = 'none';
      $('mainContent').style.display = 'none';
    }
  });

  // ============ DATA LOADING ============
  async function loadAllData() {
    await Promise.all([loadUsers(), loadRooms(), loadMessages()]);
    updateDashboard();
    updatePendingBadge();
  }

  async function loadUsers() {
    const snap = await db.collection('users').orderBy('createdAt', 'desc').get();
    allUsers = [];
    snap.forEach(doc => allUsers.push({ id: doc.id, ...doc.data() }));
  }

  async function loadRooms() {
    const snap = await db.collection('chatrooms').orderBy('createdAt', 'desc').get();
    allRooms = [];
    snap.forEach(doc => allRooms.push({ id: doc.id, ...doc.data() }));
  }

  async function loadMessages() {
    const snap = await db.collection('messages').orderBy('timestamp', 'desc').limit(200).get();
    allMessages = [];
    snap.forEach(doc => allMessages.push({ id: doc.id, ...doc.data() }));
  }

  window.refreshAll = async function() {
    showToast('Refreshing data...', 'info');
    await loadAllData();
    updateCharts();
    showToast('Data refreshed!', 'success');
  };

  // ============ DASHBOARD ============
  function updateDashboard() {
    const approved = allUsers.filter(u => u.status === 'approved');
    const pending = allUsers.filter(u => u.status === 'pending');
    const paired = approved.filter(u => u.partnerId);

    $('statTotalUsers').textContent = allUsers.length;
    $('statApproved').textContent = approved.length;
    $('statPending').textContent = pending.length;
    $('statRooms').textContent = allRooms.length;
    $('statMessages').textContent = allMessages.length;
    $('statPaired').textContent = paired.length;

    // Recent users table
    const recent = allUsers.slice(0, 5);
    let html = '';
    recent.forEach(u => {
      const partner = u.partnerId ? (allUsers.find(x => x.id === u.partnerId)?.email || 'N/A') : 'Unassigned';
      const date = u.createdAt?.toDate?.()?.toLocaleDateString('en-IN') || 'N/A';
      html += `
        <tr>
          <td><strong>${u.email}</strong></td>
          <td><span class="badge badge-purple">${u.role || 'scholar'}</span></td>
          <td><span class="badge badge-${u.status === 'approved' ? 'success' : u.status === 'pending' ? 'pending' : 'rejected'}">${u.status}</span></td>
          <td>${partner}</td>
          <td>${date}</td>
          <td>
            ${u.status === 'pending' ? `<button class="btn btn-success btn-xs" onclick="quickApprove('${u.id}')">✅</button>` : ''}
          </td>
        </tr>`;
    });
    $('recentUsersTable').innerHTML = html || '<tr><td colspan="6" class="empty-state">No users yet</td></tr>';
  }

  function updatePendingBadge() {
    const count = allUsers.filter(u => u.status === 'pending').length;
    $('pendingBadge').textContent = count;
    $('pendingBadge').style.display = count > 0 ? 'inline' : 'none';
  }

  // ============ CHARTS ============
  function initCharts() {
    const userCtx = document.getElementById('userGrowthChart')?.getContext('2d');
    const msgCtx = document.getElementById('messageActivityChart')?.getContext('2d');

    if (userCtx) {
      if (userGrowthChart) userGrowthChart.destroy();
      userGrowthChart = new Chart(userCtx, {
        type: 'line',
        data: {
          labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Today'],
          datasets: [{
            label: 'New Users',
            data: [0, 0, 0, 0, 0, 0, allUsers.length],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59,130,246,0.1)',
            fill: true,
            tension: 0.4,
            borderWidth: 2,
            pointRadius: 4,
            pointBackgroundColor: '#3b82f6'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    if (msgCtx) {
      if (messageActivityChart) messageActivityChart.destroy();
      messageActivityChart = new Chart(msgCtx, {
        type: 'bar',
        data: {
          labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Today'],
          datasets: [{
            label: 'Messages',
            data: [0, 0, 0, 0, 0, 0, allMessages.length],
            backgroundColor: '#8b5cf6',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
            x: { grid: { display: false } }
          }
        }
      });
    }
  }

  function updateCharts() {
    if (userGrowthChart) {
      userGrowthChart.data.datasets[0].data[6] = allUsers.length;
      userGrowthChart.update();
    }
    if (messageActivityChart) {
      messageActivityChart.data.datasets[0].data[6] = allMessages.length;
      messageActivityChart.update();
    }
  }

  // ============ USERS PAGE ============
  function renderAllUsers() {
    const filter = $('userFilter')?.value || 'all';
    const search = ($('userSearch')?.value || '').toLowerCase();
    
    let filtered = allUsers;
    if (filter !== 'all') filtered = filtered.filter(u => u.status === filter);
    if (search) filtered = filtered.filter(u => u.email.toLowerCase().includes(search));

    let html = '';
    filtered.forEach(u => {
      const partner = u.partnerId ? (allUsers.find(x => x.id === u.partnerId)?.email || 'N/A') : 'Unassigned';
      const date = u.createdAt?.toDate?.()?.toLocaleDateString('en-IN') || 'N/A';
      const lastSeen = u.lastSeen?.toDate?.()?.toLocaleString('en-IN') || 'Never';
      const otherUsers = allUsers.filter(x => x.id !== u.id && x.status === 'approved');

      html += `
        <tr>
          <td><strong>${u.email}</strong> ${ADMIN_EMAILS.includes(u.email) ? '👑' : ''}</td>
          <td><span class="badge badge-purple">${u.role || 'scholar'}</span></td>
          <td><span class="badge badge-${u.status === 'approved' ? 'success' : u.status === 'pending' ? 'pending' : 'rejected'}">${u.status}</span></td>
          <td>
            <select onchange="assignPartner('${u.id}', this.value)" style="font-size:0.7rem;padding:4px 8px;border-radius:4px;border:1px solid #e2e8f0;">
              <option value="">Unassigned</option>
              ${otherUsers.map(x => `<option value="${x.id}" ${u.partnerId === x.id ? 'selected' : ''}>${x.email}</option>`).join('')}
            </select>
          </td>
          <td>${date}</td>
          <td>${lastSeen}</td>
          <td>
            ${u.status === 'pending' ? `<button class="btn btn-success btn-xs" onclick="quickApprove('${u.id}')">✅</button><button class="btn btn-danger btn-xs" onclick="rejectUser('${u.id}')">❌</button>` : ''}
            ${u.partnerId ? `<button class="btn btn-warning btn-xs" onclick="assignPartner('${u.id}', '')">✕</button>` : ''}
            <button class="btn btn-outline btn-xs" onclick="deleteUser('${u.id}')">🗑</button>
          </td>
        </tr>`;
    });

    $('allUsersTable').innerHTML = html || '<tr><td colspan="7" class="empty-state"><div class="icon">👥</div><h4>No users found</h4></td></tr>';
  }

  window.filterUsers = function() { renderAllUsers(); };

  window.quickApprove = async function(uid) {
    await db.collection('users').doc(uid).update({ status: 'approved' });
    showToast('User approved!', 'success');
    await loadAllData();
    renderAllUsers();
    updateDashboard();
  };

  window.rejectUser = async function(uid) {
    await db.collection('users').doc(uid).update({ status: 'rejected' });
    showToast('User rejected', 'error');
    await loadAllData();
    renderAllUsers();
  };

  window.assignPartner = async function(uid, partnerId) {
    if (partnerId) {
      const roomId = [uid, partnerId].sort().join('_');
      await db.collection('chatrooms').doc(roomId).set({
        participants: [uid, partnerId],
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      }, { merge: true });
      await db.collection('users').doc(uid).update({ partnerId });
      await db.collection('users').doc(partnerId).update({ partnerId: uid });
      showToast('Partner assigned! Room created.', 'success');
    } else {
      const userDoc = await db.collection('users').doc(uid).get();
      const oldPartner = userDoc.data()?.partnerId;
      await db.collection('users').doc(uid).update({ partnerId: null });
      if (oldPartner) await db.collection('users').doc(oldPartner).update({ partnerId: null });
      showToast('Partner unassigned', 'warning');
    }
    await loadAllData();
    renderAllUsers();
  };

  window.deleteUser = function(uid) {
    deleteTarget = { type: 'user', id: uid };
    $('deleteModalMsg').textContent = 'This will permanently delete this user and all associated data.';
    $('deleteModal').classList.add('active');
  };

  // ============ ROOMS PAGE ============
  function renderRooms() {
    const search = ($('roomSearch')?.value || '').toLowerCase();
    let filtered = allRooms;
    if (search) filtered = filtered.filter(r => {
      const participants = (r.participants || []).map(p => allUsers.find(u => u.id === p)?.email || '').join(' ');
      return participants.toLowerCase().includes(search);
    });

    let html = '';
    filtered.forEach(r => {
      const participants = (r.participants || []).map(p => allUsers.find(u => u.id === p)?.email || 'Unknown');
      const msgCount = allMessages.filter(m => m.roomId === r.id).length;
      const created = r.createdAt?.toDate?.()?.toLocaleDateString('en-IN') || 'N/A';
      const lastMsg = allMessages.filter(m => m.roomId === r.id)[0];
      const lastActivity = lastMsg?.timestamp?.toDate?.()?.toLocaleString('en-IN') || 'No activity';

      html += `
        <tr>
          <td style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;">${r.id.substring(0, 24)}...</td>
          <td>${participants.join(' ↔ ')}</td>
          <td><strong>${msgCount}</strong></td>
          <td>${created}</td>
          <td>${lastActivity}</td>
          <td>
            <button class="btn btn-outline btn-xs" onclick="viewRoomMessages('${r.id}')">👁 View</button>
            <button class="btn btn-danger btn-xs" onclick="confirmDeleteRoom('${r.id}')">🗑</button>
          </td>
        </tr>`;
    });

    $('roomsTable').innerHTML = html || '<tr><td colspan="6" class="empty-state"><div class="icon">💬</div><h4>No rooms found</h4></td></tr>';
  }

  window.filterRooms = function() { renderRooms(); };

  window.viewRoomMessages = function(roomId) {
    navigateTo('messages');
    $('messageFilter').value = roomId;
  };

  window.confirmDeleteRoom = function(roomId) {
    deleteTarget = { type: 'room', id: roomId };
    $('deleteModalMsg').textContent = 'Delete this chat room and all its messages?';
    $('deleteModal').classList.add('active');
  };

  // ============ DELETE MODAL ============
  $('confirmDeleteBtn').addEventListener('click', async () => {
    if (!deleteTarget) return;
    try {
      if (deleteTarget.type === 'user') {
        await db.collection('users').doc(deleteTarget.id).delete();
        showToast('User deleted', 'success');
      } else if (deleteTarget.type === 'room') {
        const msgs = await db.collection('messages').where('roomId', '==', deleteTarget.id).get();
        const batch = db.batch();
        msgs.forEach(d => batch.delete(d.ref));
        batch.delete(db.collection('chatrooms').doc(deleteTarget.id));
        await batch.commit();
        showToast('Room deleted', 'success');
      }
      await loadAllData();
      if (currentPage === 'users') renderAllUsers();
      if (currentPage === 'rooms') renderRooms();
      updateDashboard();
    } catch (e) {
      showToast('Error: ' + e.message, 'error');
    }
    closeDeleteModal();
  });

  window.closeDeleteModal = function() {
    deleteTarget = null;
    $('deleteModal').classList.remove('active');
  };

  // ============ MESSAGES PAGE ============
  window.loadMessages = function() {
    const filter = $('messageFilter')?.value || 'all';
    let filtered = allMessages;
    if (filter === 'text') filtered = filtered.filter(m => m.type === 'text');
    if (filter === 'image') filtered = filtered.filter(m => m.type === 'image');

    let html = '';
    filtered.slice(0, 50).forEach(m => {
      const sender = allUsers.find(u => u.id === m.senderId)?.email || 'Unknown';
      const room = allRooms.find(r => r.id === m.roomId);
      const roomName = room ? (room.participants || []).map(p => allUsers.find(u => u.id === p)?.email?.split('@')[0] || '?').join('-') : 'N/A';
      const time = m.timestamp?.toDate?.()?.toLocaleString('en-IN') || 'N/A';
      const content = m.type === 'image' ? '📷 Image' : (m.text?.substring(0, 50) || '');

      html += `
        <tr>
          <td style="font-size:0.65rem;">${roomName}</td>
          <td>${sender}</td>
          <td><span class="badge badge-${m.type === 'image' ? 'purple' : 'info'}">${m.type}</span></td>
          <td>${content}${m.text?.length > 50 ? '...' : ''}</td>
          <td>${time}</td>
          <td>${m.seen ? '<span class="badge-dot green"></span> Seen' : '<span class="badge-dot yellow"></span> Unread'}</td>
        </tr>`;
    });

    $('messagesTable').innerHTML = html || '<tr><td colspan="6" class="empty-state">No messages</td></tr>';
  };

  // ============ ACTIVITY PAGE ============
  window.loadActivity = function() {
    const activities = [];
    
    allUsers.forEach(u => {
      if (u.createdAt) activities.push({
        event: '📝 Registration',
        user: u.email,
        details: `Status: ${u.status}`,
        time: u.createdAt.toDate?.() || new Date()
      });
      if (u.lastSeen) activities.push({
        event: '🟢 Login',
        user: u.email,
        details: 'User logged in',
        time: u.lastSeen.toDate?.() || new Date()
      });
    });

    allRooms.forEach(r => {
      if (r.createdAt) activities.push({
        event: '💬 Room Created',
        user: 'System',
        details: `Room: ${r.id.substring(0, 12)}...`,
        time: r.createdAt.toDate?.() || new Date()
      });
    });

    activities.sort((a, b) => b.time - a.time);
    const recent = activities.slice(0, 30);

    let html = '';
    recent.forEach(a => {
      html += `
        <tr>
          <td>${a.event}</td>
          <td>${a.user}</td>
          <td>${a.details}</td>
          <td>${a.time.toLocaleString?.('en-IN') || a.time}</td>
        </tr>`;
    });

    $('activityTable').innerHTML = html || '<tr><td colspan="4" class="empty-state">No activity</td></tr>';
  };

  // ============ ADMINS PAGE ============
  window.renderAdmins = function() {
    let html = '';
    ADMIN_EMAILS.forEach(email => {
      const user = allUsers.find(u => u.email === email);
      html += `
        <tr>
          <td><strong>${email}</strong> 👑</td>
          <td><span class="badge badge-purple">Admin</span></td>
          <td>${user?.createdAt?.toDate?.()?.toLocaleDateString('en-IN') || 'N/A'}</td>
          <td>
            <button class="btn btn-danger btn-xs" onclick="removeAdmin('${email}')">Remove</button>
          </td>
        </tr>`;
    });
    $('adminsTable').innerHTML = html;
  };

  window.showAddAdminModal = function() {
    const email = prompt('Enter new admin email:');
    if (email && !ADMIN_EMAILS.includes(email.toLowerCase())) {
      ADMIN_EMAILS.push(email.toLowerCase());
      showToast('Admin added! Save settings to persist.', 'success');
      renderAdmins();
    } else if (email) {
      showToast('Already an admin', 'warning');
    }
  };

  window.removeAdmin = function(email) {
    if (ADMIN_EMAILS.length <= 1) {
      showToast('Cannot remove last admin', 'error');
      return;
    }
    ADMIN_EMAILS = ADMIN_EMAILS.filter(e => e !== email);
    showToast('Admin removed. Save settings to persist.', 'warning');
    renderAdmins();
  };

  // ============ SETTINGS PAGE ============
  window.loadSettings = function() {
    $('adminEmailsInput').value = ADMIN_EMAILS.join(', ');
  };

  window.saveSettings = function() {
    const emails = $('adminEmailsInput').value.split(',').map(e => e.trim().toLowerCase()).filter(e => e);
    if (emails.length === 0) {
      showToast('At least one admin required', 'error');
      return;
    }
    ADMIN_EMAILS = emails;
    showToast('Settings saved! (Local only - update code for persistence)', 'success');
    renderAdmins();
  };

  // ============ GLOBAL SEARCH ============
  window.handleGlobalSearch = function() {
    const query = $('globalSearch').value.toLowerCase();
    if (!query) return;
    
    // Search users
    const foundUsers = allUsers.filter(u => u.email.toLowerCase().includes(query));
    // Search rooms
    const foundRooms = allRooms.filter(r => {
      const participants = (r.participants || []).map(p => allUsers.find(u => u.id === p)?.email || '');
      return participants.some(e => e.toLowerCase().includes(query));
    });

    if (foundUsers.length > 0) {
      navigateTo('users');
      $('userSearch').value = query;
      filterUsers();
    } else if (foundRooms.length > 0) {
      navigateTo('rooms');
      $('roomSearch').value = query;
      filterRooms();
    }
  };

  // ============ EXPORT ============
  window.exportData = function() {
    const data = {
      users: allUsers.map(u => ({ email: u.email, role: u.role, status: u.status, partner: u.partnerId })),
      rooms: allRooms.map(r => ({ id: r.id, participants: r.participants })),
      stats: {
        totalUsers: allUsers.length,
        approved: allUsers.filter(u => u.status === 'approved').length,
        pending: allUsers.filter(u => u.status === 'pending').length,
        rooms: allRooms.length,
        messages: allMessages.length
      }
    };

    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `studymine-export-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Data exported!', 'success');
  };

  // ============ INIT ============
  $('loginScreen').style.display = 'flex';
  $('sidebar').style.display = 'none';
  $('mainContent').style.display = 'none';

  console.log('🚀 StudyMine Advanced Admin Console Ready');
  console.log('👑 Admin Emails:', ADMIN_EMAILS);
  console.log('📊 Features: Charts, Search, Export, Activity Log');
})();
</script>
</body>
</html>
